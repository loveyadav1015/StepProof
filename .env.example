# ==============================================================================
# StepProof Environment Configuration
# ==============================================================================

# Provider selection
# STEPPROOF_LLM options: mock | openai_compat
STEPPROOF_LLM=mock

# STEPPROOF_SEG options: mock | local_sam | meta_api
STEPPROOF_SEG=mock

# Pipeline execution mode:
# - live: call provider and cache response
# - cache_only: replay strictly from cache (error if key missing)
# - refresh: call provider and overwrite cache
STEPPROOF_MODE=live

# Meta Hackathon Compliance Guard:
# 0 = dev mode (allows mocks and third-party stand-ins)
# 1 = strict compliance mode (REFUSES non-Meta providers and rejects non-Meta cached results)
# NOTE: Final hackathon submission MUST be run with STEPPROOF_REQUIRE_META=1
STEPPROOF_REQUIRE_META=0

# SQLite Cache Database path
STEPPROOF_CACHE_PATH=data/cache/stepproof_cache.db

# ------------------------------------------------------------------------------
# LLM OpenAI-Compatible Endpoint Settings
# ------------------------------------------------------------------------------
# Used when STEPPROOF_LLM=openai_compat

# Default / active values
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=meta/muse-glimmer-30b
LLM_API_KEY=ollama
# LLM_API_STYLE: chat (standard /v1/chat/completions) or responses
LLM_API_STYLE=chat

# Optional pass-through parameters (leave blank to omit)
LLM_TEMPERATURE=0.2
LLM_REASONING_EFFORT=

# ------------------------------------------------------------------------------
# Provider Configuration Presets & Examples:
# ------------------------------------------------------------------------------

# --- Preset 1: Local Ollama (Free dev stand-in, meta_compliant=false) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2-vision
# LLM_API_KEY=ollama
# LLM_API_STYLE=chat

# --- Preset 2: OpenRouter (Hosted Muse Glimmer 30B, low-cost fallback) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta/muse-glimmer-30b
# LLM_API_KEY=sk-or-v1-your-openrouter-key
# LLM_API_STYLE=chat

# --- Preset 3: Meta Model API (Official Meta API, meta_compliant=true) ---
# LLM_BASE_URL=https://api.meta.ai/v1
# LLM_MODEL=muse-wonder
# LLM_API_KEY=meta_api_key_here
# LLM_API_STYLE=chat

# --- Preset 4: Groq Dev Stand-in (Free dev stand-in, meta_compliant=false) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.2-11b-vision-preview
# LLM_API_KEY=gsk_your_groq_key
# LLM_API_STYLE=chat
